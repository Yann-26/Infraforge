      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(infraforge_agent_latency_seconds_sum{agent=~\"$agent\"}) / sum(infraforge_agent_latency_seconds_count{agent=~\"$agent\"})",
